local MenuMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    MenuMinimized = not MenuMinimized
    local targetSize = MenuMinimized and UDim2.fromOffset(360, 32) or UDim2.fromOffset(360, 270)
    MinimizeBtn.Text = MenuMinimized and "▲" or "▼"
    TabsContainer.Visible = not MenuMinimized
    
    if MenuMinimized then
        PageAimbot.Visible = false
        PageEsp.Visible = false
        PageSettings.Visible = false
    else
        PageAimbot.Visible = true
    end
    
    TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize}):Play()
end)

CloseBtn.MouseButton1Click:Connect(function()
    ClearBoxESP()
    ClearTextESP()
    ClearLineESP()
    ClearHealthESP()
    if AimbotConnection then AimbotConnection:Disconnect() end
    if FovConnection then FovConnection:Disconnect() end
    if FovGui then FovGui:Destroy() end
    if TracerGui then TracerGui:Destroy() end
    Screen:Destroy()
end)

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if BoxEspEnabled then CreateBoxESP(player) end
        if NameEspEnabled or DistanceEspEnabled then CreateTextESP(player) end
        if HealthEspEnabled then CreateHealthESP(player) end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    RemovePlayerESP(player)
end)

for _, p in ipairs(Players:GetPlayers()) do
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        if BoxEspEnabled then CreateBoxESP(p) end
        if NameEspEnabled or DistanceEspEnabled then CreateTextESP(p) end
        if HealthEspEnabled then CreateHealthESP(p) end
    end)
end
