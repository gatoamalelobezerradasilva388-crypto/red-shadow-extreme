local function UpdateFovCircle()
    if FovVisible and FovRadius > 0 then
        local diameter = FovRadius * 2
        FovFrame.Size = UDim2.fromOffset(diameter, diameter)
        FovFrame.Visible = true
    else
        FovFrame.Visible = false
    end
end

local function ToggleFovVisible(state)
    FovVisible = state
    UpdateFovCircle()
    if state and not FovConnection then
        FovConnection = RunService.RenderStepped:Connect(function()
            UpdateFovCircle()
        end)
    elseif not state and FovConnection then
        FovConnection:Disconnect()
        FovConnection = nil
        FovFrame.Visible = false
    end
end

local function ClearBoxESP()
    for _, highlight in pairs(EspBoxObjects) do
        if highlight then pcall(function() highlight:Destroy() end) end
    end
    table.clear(EspBoxObjects)
end

local function ClearTextESP()
    for _, gui in pairs(EspTextObjects) do
        if gui then pcall(function() gui:Destroy() end) end
    end
    table.clear(EspTextObjects)
end

local function ClearLineESP()
    for _, lineObj in pairs(LineObjects) do
        if lineObj and lineObj.Gui then pcall(function() lineObj.Gui:Destroy() end) end
    end
    table.clear(LineObjects)
end

local function ClearHealthESP()
    for _, data in pairs(HealthObjects) do
        if data.Gui then pcall(function() data.Gui:Destroy() end) end
    end
    table.clear(HealthObjects)
end

local function RemovePlayerESP(player)
    if EspBoxObjects[player] then
        pcall(function() EspBoxObjects[player]:Destroy() end)
        EspBoxObjects[player] = nil
    end
    if EspTextObjects[player] then
        pcall(function() EspTextObjects[player]:Destroy() end)
        EspTextObjects[player] = nil
    end
    if LineObjects[player] then
        if LineObjects[player].Gui then pcall(function() LineObjects[player].Gui:Destroy() end) end
        LineObjects[player] = nil
    end
    if HealthObjects[player] then
        if HealthObjects[player].Gui then pcall(function() HealthObjects[player].Gui:Destroy() end) end
        HealthObjects[player] = nil
    end
end

local function CreateBoxESP(player)
    if player == LocalPlayer or EspBoxObjects[player] then return end
    local character = player.Character
    if not character then return end

    local success, highlight = pcall(function()
        local h = Instance.new("Highlight")
        h.Adornee = character
        h.FillTransparency = 1
        h.OutlineColor = Color3.fromRGB(0, 170, 255)
        h.Parent = character
        return h
    end)
    if success then EspBoxObjects[player] = highlight end
end

local function CreateTextESP(player)
    if player == LocalPlayer or EspTextObjects[player] then return end
    local character = player.Character
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end

    local success, gui = pcall(function()
        local g = Instance.new("BillboardGui")
        g.Name = "NexusTextESP"
        g.Adornee = head
        g.Size = UDim2.fromOffset(200, 50)
        g.StudsOffset = Vector3.new(0, 2.5, 0)
        g.AlwaysOnTop = true
        g.Parent = head

        local text = Instance.new("TextLabel")
        text.Size = UDim2.fromScale(1, 1)
        text.BackgroundTransparency = 1
        text.TextColor3 = Color3.fromRGB(0, 200, 255)
        text.TextStrokeTransparency = 0
        text.TextSize = 14
        text.Font = Enum.Font.GothamBold
        text.Parent = g
        return g
    end)
    if success then EspTextObjects[player] = gui end
end

local function CreateHealthESP(player)
    if player == LocalPlayer or HealthObjects[player] then return end
    local character = player.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not head or not humanoid or humanoid.Health <= 0 then return end

    local success, data = pcall(function()
        local gui = Instance.new("BillboardGui")
        gui.Name = "NexusHealthESP"
        gui.Adornee = head
        gui.Size = UDim2.fromOffset(120, 40)
        gui.StudsOffset = Vector3.new(-1.2, 2, 0)
        gui.AlwaysOnTop = true
        gui.Parent = head

        local backgroundBar = Instance.new("Frame")
        backgroundBar.Size = UDim2.new(0, 4, 1, 0)
        backgroundBar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        backgroundBar.BorderSizePixel = 0
        backgroundBar.Parent = gui

        local bgCorner = Instance.new("UICorner")
        bgCorner.CornerRadius = UDim.new(0, 2)
        bgCorner.Parent = backgroundBar

        local healthFill = Instance.new("Frame")
        healthFill.Size = UDim2.new(1, 0, 1, 0)
        healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        healthFill.BorderSizePixel = 0
        healthFill.Parent = backgroundBar

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(0, 2)
        fillCorner.Parent = healthFill

        return { Gui = gui, Fill = healthFill, Humanoid = humanoid }
    end)
    if success then HealthObjects[player] = data end
end

local function UpdateTextESP()
    if not NameEspEnabled and not DistanceEspEnabled then
        ClearTextESP()
        if EspConnection then
            EspConnection:Disconnect()
            EspConnection = nil
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then CreateTextESP(player) end
    end

    if not EspConnection then
        EspConnection = RunService.RenderStepped:Connect(function()
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

            for player, gui in pairs(EspTextObjects) do
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local textLabel = gui and gui:FindFirstChildOfClass("TextLabel")

                if char and root and textLabel and myRoot then
                    local content = ""
                    if NameEspEnabled then
                        content = player.Name
                    end
                    if DistanceEspEnabled then
                        local distance = (myRoot.Position - root.Position).Magnitude
                        local distText = "[" .. math.floor(distance) .. " studs]"
                        content = (content ~= "" and (content .. " " .. distText)) or distText
                    end
                    textLabel.Text = content
                else
                    RemovePlayerESP(player)
                end
            end
        end)
    end
end

local function ToggleBoxESP(state)
    BoxEspEnabled = state
    ClearBoxESP()
    if state then
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then CreateBoxESP(player) end
        end
    end
end

local function ToggleNameESP(state)
    NameEspEnabled = state
    UpdateTextESP()
end

local function ToggleDistanceESP(state)
    DistanceEspEnabled = state
    UpdateTextESP()
end

local function ToggleHealthESP(state)
    HealthEspEnabled = state
    ClearHealthESP()
    if state then
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then CreateHealthESP(player) end
        end

        HealthEspConnection = RunService.RenderStepped:Connect(function()
            for player, data in pairs(HealthObjects) do
                if player.Character and data.Humanoid and data.Humanoid.Parent then
                    local healthPercent = math.clamp(data.Humanoid.Health / data.Humanoid.MaxHealth, 0, 1)
                    data.Fill.Size = UDim2.new(1, 0, healthPercent, 0)
                    data.Fill.Position = UDim2.new(0, 0, 1 - healthPercent, 0)
                else
                    if data.Gui then pcall(function() data.Gui:Destroy() end) end
                    HealthObjects[player] = nil
                end
            end
        end)
    else
        if HealthEspConnection then
            HealthEspConnection:Disconnect()
            HealthEspConnection = nil
        end
        ClearHealthESP()
    end
end

